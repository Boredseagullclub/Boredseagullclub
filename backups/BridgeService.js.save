const { ethers } = require('ethers');
const { Client: XrplClient, xrpToDrops, Wallet } = require('xrpl');
const StellarSdk = require('stellar-sdk');
const { 
    Client: HbarClient, 
    PrivateKey, 
    TransferTransaction, 
    AccountId, 
    TokenId 
} = require("@hashgraph/sdk");
const Decimal = require('decimal.js');
const { Builder } = require('xml2js');
require('dotenv').config();

function generatePacs008(txHash, receiver, amount, symbol, chain) {
  const builder = new Builder();
  const msg = {
    Document: {
      $: { xmlns: "urn:iso:std:iso:20022:tech:xsd:pacs.008.001.08" },
      FIToFICstmrCdtTrf: {
        GrpHdr: { MsgId: `SEAGULL-${chain}-${Date.now()}`, CreDtTm: new Date().toISOString(), NbOfTxs: "1", SttlmInf: { SttlmMtd: "CLRG" } },
        CdtTrfTxInf: {
          PmtId: { EndToEndId: txHash },
          IntrBkSttlmAmt: { $: { Ccy: symbol }, _: amount },
          InstdAmt: { $: { Ccy: symbol }, _: amount },
          ChrgBr: "DEBT",
          Dbtr: { Nm: "Seagull Hot Wallet", Role: "TREASURY" },
          Cdtr: { Nm: "End User", PstlAdr: { AdrLine: receiver } },
          SplmtryData: { Envlp: { TxHash: txHash, Chain: chain } }
        }
      }
    }
  };
  return builder.buildObject(msg);
}

async function settleOnChain(walletAddress, tokenSymbol, amount, chain) {
  const symbol = tokenSymbol.toUpperCase();
  const chainUpper = chain.toUpperCase();
  let txHash;
  const rawAmount = new Decimal(amount.toString());
  const amountToActuallySend = rawAmount.minus(rawAmount.times(0.004));

  switch (chainUpper) {
    case 'XRPL': {
      const xClient = new XrplClient(process.env.XRPL_RPC_URL);
      await xClient.connect();
      const xWallet = Wallet.fromSeed(process.env.BRIDGE_XRPL_SECRET);
      const prepared = await xClient.autofill({
        TransactionType: 'Payment', Account: process.env.BRIDGE_XRPL_ADDRESS, Destination: walletAddress,
        Amount: (symbol === 'XRP') ? xrpToDrops(amountToActuallySend.toFixed(6)) : {
          currency: symbol, issuer: process.env.BRIDGE_XRPL_ADDRESS, value: amountToActuallySend.toFixed(6)
        }
      });
      const result = await xClient.submitAndWait(xWallet.sign(prepared).tx_blob);
      await xClient.disconnect();
      txHash = result.result.hash;
      break;
    }
    case 'XDC': {
      const provider = new ethers.JsonRpcProvider(process.env.XDC_RPC_URL || 'https://erpc.xinfin.network');
      let pk = process.env.BRIDGE_XDC_PRIVATE_KEY;
      if (pk && !pk.startsWith('0x')) pk = '0x' + pk;
      const wallet = new ethers.Wallet(pk, provider);
      const target = ethers.getAddress(walletAddress.replace(/^xdc/, '0x'));
      const tx = await wallet.sendTransaction({ to: target, value: ethers.parseEther(amountToActuallySend.toString()) });
      const receipt = await tx.wait();
      txHash = receipt.hash;
      break;
    }
    case 'XLM': {
      const SEAGULL_ISSUER = 'GBC2VA3YMAIVB3A77VNRPKMQI3RAPDUDDP7JI2PE426MGKDDJFPRVWP7';
      const allowed = ['XLM', 'SEAGULLCASH'];
      if (!allowed.includes(symbol)) throw new Error(`🛑 SECURITY: ${symbol} unauthorized on Stellar`);

      const server = new StellarSdk.Horizon.Server(process.env.STELLAR_RPC_URL || 'https://horizon.stellar.org');
      const source = StellarSdk.Keypair.fromSecret(process.env.BRIDGE_STELLAR_SECRET);
      const account = await server.loadAccount(source.publicKey());
      let asset = (symbol === 'XLM') ? StellarSdk.Asset.native() : new StellarSdk.Asset('SEAGULLCASH', SEAGULL_ISSUER);
      const tx = new StellarSdk.TransactionBuilder(account, { fee: StellarSdk.BASE_FEE, networkPassphrase: StellarSdk.Networks.PUBLIC })
        .addOperation(StellarSdk.Operation.payment({ destination: walletAddress, asset, amount: amountToActuallySend.toFixed(7) }))
        .setTimeout(30).build();
      tx.sign(source);
      const res = await server.submitTransaction(tx);
      txHash = res.hash;
      break;
    }
    case 'HBAR': {
      const SEAGULL_TOKEN_ID = process.env.HEDERA_TOKEN_ID;
      const client = HbarClient.forMainnet();
      client.setOperator(process.env.HEDERA_ACCOUNT_ID, process.env.HEDERA_PRIVATE_KEY);
      
      const transaction = await new TransferTransaction()
        .addTokenTransfer(SEAGULL_TOKEN_ID, process.env.HEDERA_ACCOUNT_ID, -amountToActuallySend.toNumber())
        .addTokenTransfer(SEAGULL_TOKEN_ID, walletAddress, amountToActuallySend.toNumber())
        .freezeWith(client);

      const signTx = await transaction.sign(PrivateKey.fromString(process.env.HEDERA_PRIVATE_KEY));
      const response = await signTx.execute(client);
      const receipt = await response.getReceipt(client);
      txHash = response.transactionId.toString();
      break;    }
    default: throw new Error(`Chain ${chain} not supported`);
  }

  const isoMetadata = generatePacs008(txHash, walletAddress, amountToActuallySend.toString(), symbol, chainUpper);
  console.log(isoMetadata);
  return txHash;
}
module.exports = { settleOnChain };
