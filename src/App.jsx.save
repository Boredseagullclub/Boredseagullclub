import React, { useState } from 'react';
import { useBridge } from './hooks/useBridge';
import AssetList from './components/AssetList';
import { Shield, Zap, Activity, Lock, X } from 'lucide-react'; // Added 'X' icon

function App() {
  const [id, setId] = useState(null);
  const [showImport, setShowImport] = useState(false);
  const [secretInput, setSecretInput] = useState("");
  const { user, loading } = useBridge(id);

  if (!id) {
    return (
      <div className="min-h-screen bg-slate-950 flex flex-col items-center justify-center p-6 relative overflow-hidden">
        {/* Background Glow */}
        <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-teal-500/5 blur-[120px] rounded-full pointer-events-none"></div>

        <div className="max-w-md w-full bg-slate-900 border border-slate-800 p-8 rounded-3xl shadow-2xl text-center relative z-10">
          <h1 className="text-4xl font-black text-white tracking-tighter mb-2">
            SEAGULL<span className="text-teal-500">NET</span>
          </h1>
          <p className="text-slate-500 mb-8 font-medium">ISO 20022 Sovereign Bridge</p>

          <div className="space-y-4">
            <button className="w-full py-4 bg-teal-500 hover:bg-teal-400 text-slate-950 font-bold rounded-2xl transition-all flex items-center justify-center gap-2">
              ✨ Create New Account
            </button>

            <button
              onClick={() => setShowImport(true)}
              className="w-full py-4 bg-slate-800 hover:bg-slate-700 text-white font-bold rounded-2xl border border-slate-700 transition-all flex items-center justify-center gap-2"
            >
              🔑 Import Secret Seeds
            </button>
          </div>
        </div>

        {/* --- THE IMPORT MODAL --- */}
        {showImport && (
          <div className="fixed inset-0 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-6 z-50">
            <div className="bg-slate-900 border border-slate-800 p-8 rounded-3xl max-w-sm w-full shadow-2xl">
              <div className="flex justify-between items-center mb-6">
                <h2 className="text-xl font-bold text-white">Import Secret</h2>
                <button onClick={() => setShowImport(false)} className="text-slate-500 hover:text-white">
                  <X size={20} />
                </button>
              </div>

              <p className="text-slate-400 text-sm mb-4">Enter your XRPL (s...) or Stellar (S...) secret key.</p>

              <input
                type="password"
                placeholder="Secret Key"
                className="w-full bg-slate-950 border border-slate-800 p-4 rounded-xl text-teal-400 mb-6 focus:outline-none focus:border-teal-500 font-mono"
                value={secretInput}
                onChange={(e) => setSecretInput(e.target.value)}
              />

              <div className="flex gap-3">
                <button
                  onClick={async () => {
                    try {
                      const response = await fetch('https://www.seagull-xlm.xyz/api/auth/import', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ secret: secretInput })
                      });
                      const data = await response.json();
                      if (data.success) {
                        setId(data.address); 
                        setShowImport(false);
                      } else {
                        alert("Invalid Secret Seed.");
                      }
                    } catch (err) {
                      alert("Tank Offline!");
                    }
                  }}
                  className="flex-1 py-4 bg-teal-500 hover:bg-teal-400 text-slate-950 font-bold rounded-xl"
                >
                  Connect
                </button>
              </div>
            </div>
          </div>
        )}
      </div>
    );
  }


  // --- REST OF YOUR DASHBOARD CODE ---
  if (loading) {
    return (
      <div className="min-h-screen bg-slate-950 flex items-center justify-center">
        <div className="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-teal-500"></div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-slate-950 text-slate-200 font-sans selection:bg-teal-500/30">
      {/* ... (Keep your existing dashboard return here) ... */}
    </div>
  );
}

export default App;
